# скопируйте в .env и заполните; .env в git не попадает
# токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# случайная строка для проверки запросов webhook (буквы, цифры, _ и -, до 256 символов)
TELEGRAM_WEBHOOK_SECRET=
# адрес бэкенда для регистрации webhook, например https://turanassist-backend.onrender.com
PUBLIC_BASE_URL=
